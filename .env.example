# ============================================================================
# PrintMate AI — environment variables
# ============================================================================
# Copy to .env.local for local dev:   cp .env.example .env.local
# NO REAL SECRETS IN THIS FILE — it is committed to git as documentation only.
#
# Which keys you need:
#   Local demo .............. NONE. The app runs on built-in demo data.
#   Full local (Supabase + Stripe test) ... Supabase ×3, Stripe ×3, app URL.
#   Production .............. everything, with LIVE Stripe keys + verified domain.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase — required for: full local, production.  Not needed for local demo.
# Where: supabase.com → your project → Settings → API
# ----------------------------------------------------------------------------

# Public project URL (safe to expose; used by both server and browser clients).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose; only grants what RLS policies allow —
# read active products, insert orders/customers).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service-role key (SECRET — server only, never expose to the browser).
# Bypasses RLS; used by API routes and admin pages via lib/supabase.ts.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ----------------------------------------------------------------------------
# Stripe — required for: full local, production.  Not needed for local demo.
# Where: dashboard.stripe.com → Developers → API keys (starts in TEST mode).
# ----------------------------------------------------------------------------

# Secret key (SECRET — server only). Test key starts with sk_test_,
# live key starts with sk_live_. Get it from the Stripe dashboard.
STRIPE_SECRET_KEY=sk_test_...

# Publishable key (safe to expose; used by the checkout button).
# Test: pk_test_...   Live: pk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret (SECRET — server only). Starts with whsec_.
# Local:  run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#         and copy the secret it prints.
# Prod:   dashboard.stripe.com → Developers → Webhooks → Add endpoint
#         https://<your-vercel-url>/api/webhooks/stripe
#         event: checkout.session.completed → copy the Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# ----------------------------------------------------------------------------
# Resend — required for: production.  Optional for local dev/test.
# Where: resend.com → API Keys.
# Free tier sends test emails; production sending requires verifying your
# own domain (see DEPLOY.md Step 4).
# ----------------------------------------------------------------------------

# Resend API key (SECRET — server only).
RESEND_API_KEY=re_...

# Verified sender address for order emails, e.g. "PrintMate <orders@yourdomain.com>".
# Until your domain is verified, Resend only delivers to the account owner's email.
EMAIL_FROM=PrintMate <onboarding@resend.dev>

# ----------------------------------------------------------------------------
# Admin panel — required for: full local, production (to view/manage orders).
# ----------------------------------------------------------------------------

# Password for the admin panel (/admin). Generate one with:
#   openssl rand -base64 24
ADMIN_PASSWORD=change-me-to-a-random-value

# ----------------------------------------------------------------------------
# App URL — required for: full local, production.
# Used to build Stripe success/cancel redirect URLs.
# ----------------------------------------------------------------------------

# Local:      http://localhost:3000
# Production: https://<your-app>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# AI image provider — optional.
# ----------------------------------------------------------------------------

# Design-image backend for the Studio page.
# "pollinations" = free, no key needed (default). "openai" = needs OPENAI_API_KEY.
IMAGE_PROVIDER=pollinations

# Only required when IMAGE_PROVIDER=openai. (SECRET — server only.)
# Where: platform.openai.com → API keys.
OPENAI_API_KEY=sk-...
